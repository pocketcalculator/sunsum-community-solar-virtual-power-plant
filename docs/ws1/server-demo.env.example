# Fictional server-backed demo only. Bind the local server to 127.0.0.1.
# Never combine these values with a database store or real participant records.
SUNSUM_PUBLIC_DATA_MODE=server-demo
SUNSUM_PUBLIC_API_BASE_URL=/api
SUNSUM_STORE=mock
SUNSUM_DEMO_AUTH=enabled
SUNSUM_BLOB=memory
SUNSUM_VIABILITY=demo

# Independent disclosure gates default off; identity comes from GET /api/me.
SUNSUM_LIVE_READ_AUTH_APPROVED=false
SUNSUM_LIVE_EXPORT_APPROVED=false
SUNSUM_LIVE_DOCUMENTS_APPROVED=false

# A server-only SUNSUM_SESSION_SECRET of at least 32 characters is required.
# The guide generates an ephemeral local key without printing or committing it.
# No DATABASE_URL, PG* values, Azure credentials or production cookie is needed.
# This is not production sign-in; do not use it to recover failed connected reads.
