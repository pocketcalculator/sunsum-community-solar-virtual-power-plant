# Connected-mode operator example. Do not load into Pages or server-demo.
# Future separately approved database-backed environment only.
# The current infrastructure-controlled dev target intentionally stays SUNSUM_STORE=mock.
# Do not apply this example there as a GIS/UI fix or bypass its fixture-store guard.
# The historical LIVE_READ name is an admission gate, not a read-only promise.
# Set approval flags only after the existing sign-in/mapping/disclosure handoff.
SUNSUM_PUBLIC_DATA_MODE=connected
SUNSUM_PUBLIC_API_BASE_URL=/api
SUNSUM_LIVE_READ_AUTH_APPROVED=false
SUNSUM_LIVE_EXPORT_APPROVED=false
SUNSUM_LIVE_DOCUMENTS_APPROVED=false

# Existing server settings, configured through the owner's secure process:
SUNSUM_STORE=db
SUNSUM_DEMO_AUTH=false
# SUNSUM_SESSION_SECRET is server-only. No example secret is supplied.
# Use the existing approved session configuration; do not mint a participant cookie.
# DATABASE_URL and SUNSUM_DB_AUTH belong to the existing application store.
# PG* and SUNSUM_DATABASE_AUTH are a different operator-tooling contract.
# Blob selection is independent: unset SUNSUM_BLOB means memory in the source adapter.
# Future SUNSUM_BLOB=azure also needs AZURE_STORAGE_ACCOUNT_NAME and authorized Entra access.
# These names prove no deployed setting, container or bytes; do not change cloud configuration here.
# Connected identities must not be the known seeded demo principals.
# canAttemptInterest admits only the explicit project-level POST with body {}.
# It is derived by the resolver, not a new environment flag or generic write grant.
