# Names-only operator example. Do not load this into the Pages build.
# Set approval flags only after the service owner's existing-auth/disclosure handoff.
SUNSUM_PUBLIC_DATA_MODE=connected
SUNSUM_PUBLIC_API_BASE_URL=/api
SUNSUM_LIVE_READ_AUTH_APPROVED=false
SUNSUM_LIVE_EXPORT_APPROVED=false
SUNSUM_LIVE_DOCUMENTS_APPROVED=false

# Existing server settings, configured through the owner's secure process:
SUNSUM_STORE=db
SUNSUM_DEMO_AUTH=false
# SUNSUM_SESSION_SECRET is server-only. No example secret is supplied.
# DATABASE_URL and SUNSUM_DB_AUTH belong to the existing application store.
# PG* and SUNSUM_DATABASE_AUTH are a different operator-tooling contract.
