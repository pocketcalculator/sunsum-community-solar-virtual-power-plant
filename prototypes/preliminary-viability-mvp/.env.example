# Local defaults
SUNSUM_ENVIRONMENT=local
SUNSUM_DATABASE_URL=sqlite:///./data/sunsum.db
SUNSUM_UPLOAD_DIR=data/uploads
SUNSUM_MAX_UPLOAD_BYTES=10485760

# Azure Maps: use a key locally, or managed identity plus the Maps client ID in Azure.
SUNSUM_AZURE_MAPS_KEY=
SUNSUM_AZURE_MAPS_CLIENT_ID=
SUNSUM_USE_AZURE_IDENTITY=false

# Optional Azure OpenAI multimodal analysis. Endpoint and deployment are both required.
SUNSUM_AZURE_OPENAI_ENDPOINT=
SUNSUM_AZURE_OPENAI_API_KEY=
SUNSUM_AZURE_OPENAI_DEPLOYMENT=
SUNSUM_AZURE_OPENAI_API_VERSION=2024-10-21
