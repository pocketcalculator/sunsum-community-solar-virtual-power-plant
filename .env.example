# Copy to `.env.local` and adjust. `.env.local` is gitignored; this file is not.
#
# Nothing here is a real secret. The local database password matches
# docker-compose.yml and protects a throwaway container.

# The local PostgreSQL from docker-compose.yml. Port 55432, not 5432, to avoid
# colliding with an existing installation.
DATABASE_URL=postgresql://sunsum:devpassword@localhost:55432/sunsum

# Which store the backend reads from.
#
#   mock  the in-memory fixtures in core/projects/mock-store.ts (the default)
#   db    the PostgreSQL store in backend/db
#
# The seam exists so the two are interchangeable. `npm run db:seed` loads the
# same five projects the mock holds, so `GET /portfolio` returns byte-identical
# responses either way — which is how we know swapping the store changed the
# source of the data and nothing else.
SUNSUM_STORE=mock
